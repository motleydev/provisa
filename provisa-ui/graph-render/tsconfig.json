{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "react"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "typeRoots": ["./node_modules/@types", "../node_modules/@types"]
  },
  // This program is Node's, but draw.ts and look.ts import the UI's own graph sources, so the
  // program contains provisa-ui/src files and needs the ambient declarations those files are
  // written against: cytoscape's, and the app's vite-env.d.ts for `import.meta.env`
  // (graph-stylesheet -> graph-model -> api/admin.ts, which reads import.meta.env.VITE_API_BASE).
  "include": ["src", "../src/types/cytoscape*.d.ts", "../src/vite-env.d.ts"]
}
