---
/**
 * Every page: head metadata, the utility bar, header, the page, the closing
 * ContactBand with the "Keep me posted" signup (unless a page opts out) and
 * the footer.
 */
import '../styles/site.css';
import { ContactBand, SignupForm, SiteFooter, SiteHeader, UtilityBar } from '../components/ds';
import {
  CONTACT,
  FOOTER_BLURB,
  FOOTER_COLUMNS,
  HEADER_CTA,
  HEADER_SECONDARY,
  LEGAL,
  NAV,
  SIGNUP,
  SITE_URL,
  UTILITY,
} from '../data/site';

interface Props {
  /** Full document title. */
  title: string;
  description: string;
  /** Social description, when it differs from `description`. */
  ogDescription?: string;
  /** Label of the nav item to mark as current. */
  active?: string;
  /** Closing band: 'forest' (home), 'ink' (default) or false for none. */
  contact?: 'forest' | 'ink' | false;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, ogDescription = description, active, contact = 'ink', noindex = false, ogType = 'article' } = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = new URL(path === '' ? '/' : path, SITE_URL).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f8f6f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/source-serif-4-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content="Provisa" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="pv-skip" href="#main">Skip to content</a>
    <UtilityBar message={UTILITY.message} link={UTILITY.link} links={UTILITY.links} />
    <SiteHeader items={NAV} active={active} badge="Preview" secondary={HEADER_SECONDARY} cta={HEADER_CTA} />
    <main id="main">
      <slot />
    </main>
    {
      contact && (
        <ContactBand tone={contact} title={CONTACT.title} sub={CONTACT.sub} links={CONTACT.links}>
          <SignupForm slot="form" title={SIGNUP.title} lead={SIGNUP.lead} fine={SIGNUP.fine} />
        </ContactBand>
      )
    }
    <SiteFooter blurb={FOOTER_BLURB} columns={FOOTER_COLUMNS} copyright={`© ${year} Provisa`} legal={LEGAL} />
    <script>
      import { initBehaviors } from '../components/ds/behaviors';
      import { markDetectedOs } from '../scripts/downloads';
      import { initForms } from '../scripts/forms';

      initBehaviors();
      initForms();
      markDetectedOs();
    </script>
  </body>
</html>
