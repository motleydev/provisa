---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  Block,
  Card,
  CodeBlock,
  Grid,
  Links,
  PageHero,
  ProtocolList,
  Section,
  SplitHeader,
  Stack,
  StackCells,
  StackFills,
  StackNote,
  TintCard,
} from '../../components/ds';
import { LINKS } from '../../data/site';

const languages = [
  {
    name: 'GraphQL',
    wire: 'HTTP',
    tone: 'cobalt' as const,
    body: 'Per-role schemas with field-level visibility, cursor pagination, and aggregates. The schema only contains registered relationships, so a query over an unapproved path cannot be written at all. Apollo Automatic Persisted Queries are included.',
  },
  {
    name: 'SQL',
    wire: 'pgwire · JDBC',
    tone: 'forest' as const,
    body: 'Full SQL over federated data, correlated subqueries included. Cross-source joins fan out through the federation engine. Single-source queries skip federation and go straight to the driver: transactional, under 100ms.',
  },
  {
    name: 'Cypher',
    wire: 'Bolt',
    tone: 'vermilion' as const,
    body: 'Graph queries over the same federated model. Traverse relationships as edges, union sources into one node label, and walk variable-length paths, under the same governance as SQL and GraphQL.',
  },
];

const protocols = [
  {
    name: 'pgwire',
    meta: 'port 5439',
    body: 'psql, DBeaver, DataGrip, pandas `read_sql`, and anything else that speaks the Postgres protocol. `pg_catalog` is answered in memory, so schema browsers, foreign-key arrows, and autocomplete work with no Postgres behind them.',
    code: 'psql -h provisa -p 5439',
  },
  {
    name: 'Bolt',
    meta: 'Neo4j',
    body: 'Neo4j Browser, Bloom, and the official drivers run Cypher against the federated graph. Each role appears as a `provisa_<role>` database, so the database picker is the governance boundary.',
    code: 'bolt://provisa:7687',
  },
  {
    name: 'Arrow Flight',
    meta: 'gRPC · columnar',
    body: 'Arrow record batches streamed out with no row-by-row serialization. Accepts SQL or GraphQL. Result sets are unbounded; nothing is held server-side while the client reads.',
    code: 'grpc://provisa:8815',
  },
  {
    name: 'gRPC model API',
    meta: 'generated .proto',
    body: 'Typed query and insert RPCs per table, with streamed responses. The `.proto` is regenerated when the model changes, with no separate build step.',
    code: 'provisa.v1.ProvisaService/QueryOrders',
  },
  {
    name: 'JDBC, REST, JSON:API',
    meta: 'OpenAPI 3.1',
    body: 'Tableau, Power BI, and DBeaver connect over JDBC. Applications get plain REST at `/data/rest/{table}` and JSON:API 1.1 at `/data/jsonapi/{table}` over the same model, described by a generated OpenAPI document for typed SDKs.',
    code: 'GET /data/rest/orders',
  },
  {
    name: 'Airport',
    meta: 'DuckDB',
    body: 'Any DuckDB client attaches Provisa as a database and queries the governed model locally. Filters and projections push down; writes update by primary key.',
    code: "ATTACH 'grpc://provisa' AS p (TYPE AIRPORT)",
  },
  {
    name: 'WebSocket and SSE',
    meta: 'subscriptions',
    body: 'Near-real-time change events. The backend is your choice: Postgres notifications, MongoDB change streams, CDC, or polling, with optional fan-out over Kafka.',
    code: 'subscription { orders { id } }',
  },
];

const domainSql = `
-- Each domain is a schema
SELECT s.id, s.total, f.invoice_no
FROM sales.orders s
JOIN finance.orders f ON f.order_id = s.id;`;
---

<BaseLayout
  title="Query interfaces & wire protocols — Provisa"
  description="Three query languages and nine wire protocols over one federated model: GraphQL, SQL, Cypher over pgwire, Bolt, Arrow Flight, gRPC, JDBC, REST, WebSocket, Airport, and MCP."
  current="/why/interfaces"
>
  <PageHero
    crumbs={[{ label: 'Provisa', href: '/' }, { label: 'Interfaces' }]}
    eyebrow="Query languages and wire protocols"
    eyebrowTone="cobalt"
    title="Three languages. Nine protocols. One model."
    lede="The query language and the wire protocol are separate choices. Every entry point resolves against the same federated model and passes through the same governance. No path in skips it."
    actions={[
      { label: 'Book a demo', href: '#contact' },
      { label: 'Start a free trial', href: LINKS.cloud, variant: 'outline' },
    ]}
  >
    <Stack slot="aside" label="Three languages over nine protocols">
      <StackFills
        items={[
          { label: 'GraphQL', tone: 'cobalt' },
          { label: 'SQL', tone: 'forest' },
          { label: 'Cypher', tone: 'vermilion' },
        ]}
      />
      <StackCells items={['pgwire', 'Bolt', 'Arrow Flight', 'gRPC', 'JDBC', 'REST', 'WebSocket', 'Airport', 'MCP']} />
      <StackNote label="ONE MODEL">Same compiler, same six governance layers</StackNote>
    </Stack>
  </PageHero>

  <Section tone="surface" labelledBy="domains-title">
    <SplitHeader eyebrow="Domains" eyebrowTone="forest" title="One model, many namespaces" titleId="domains-title">
      <p class="t-body-lg pv-body">
        Sources are divided into domains, and a SQL client sees each domain as a schema. <code>sales.orders</code> and
        <code>finance.orders</code> stay distinct while resolving through the same governed model.
      </p>
      <CodeBlock code={domainSql} comments="dash" accent="forest" label="Query two domains as two schemas" />
    </SplitHeader>
  </Section>

  <Section labelledBy="languages-title">
    <Block>
      <SplitHeader eyebrow="Query languages" eyebrowTone="cobalt" title="Pick the language that fits the question" titleId="languages-title">
        <p class="t-body-lg pv-body">
          All three compile against the same registered model, so the relationships, masking, and row filters are identical whichever one
          you write.
        </p>
      </SplitHeader>
      <Grid min={300} gap={16}>
        {languages.map((l) => <TintCard tone={l.tone} title={l.name} meta={l.wire} body={l.body} titleClass="t-h3-lg" />)}
      </Grid>
    </Block>
  </Section>

  <Section tone="surface" labelledBy="protocols-title">
    <Block>
      <SplitHeader eyebrow="Wire protocols" eyebrowTone="vermilion" title="Connect with the client you already use" titleId="protocols-title">
        <p class="t-body-lg pv-body">Each protocol is a way in, not a separate product. Nothing on this list has its own policy engine.</p>
      </SplitHeader>
      <ProtocolList items={protocols} />
    </Block>
  </Section>

  <Section tone="forest" labelledBy="agents-title">
    <SplitHeader eyebrow="For AI agents" title="Agents get the same governed path as people" titleId="agents-title">
      <Card
        variant="paper"
        title="MCP server"
        body="A Model Context Protocol server, over stdio and remote Streamable HTTP, exposes governed, federated data to agents like Claude as tools. The OAuth token maps to a role, so every agent call passes the same six layers as a human query. There is no bypass and no separate policy to keep in sync."
      />
      <Card
        variant="paper"
        title="Natural language"
        body="NL to SQL, Cypher, or GraphQL, powered by Claude, with a validation loop so a generated query is reviewed before anything executes."
      />
      <div style="padding-top: 8px">
        <Links
          items={[
            { label: 'How governance applies to all of them', href: '/why/governance' },
            { label: 'What makes the layer active', href: '/why/active-semantic-layer' },
          ]}
        />
      </div>
    </SplitHeader>
  </Section>
</BaseLayout>
