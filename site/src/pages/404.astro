---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Eyebrow, Heading, HeroCTAs, Lede, Links, Sec, Stack } from '../components/ds';
---

<BaseLayout title="Page not found — Provisa" description="The page you asked for doesn’t exist or has moved." contact={false} noindex>
  <Sec labelledBy="nf-title">
    <Stack gap={28}>
      <Eyebrow tone="vermilion">404 · Not found</Eyebrow>
      <Heading level="page" id="nf-title">This page isn’t here.</Heading>
      <Lede>The page you asked for doesn’t exist or has moved. These are the places most people are looking for.</Lede>
      <HeroCTAs primary={{ label: 'Go to the home page', href: '/' }} secondary={{ label: 'Read the docs', href: '/docs/' }} />
      <Links
        links={[
          { label: 'Governance', href: '/why/governance' },
          { label: 'Interfaces', href: '/why/interfaces' },
          { label: 'Sources', href: '/why/sources' },
          { label: 'Download', href: '/#download' },
        ]}
      />
    </Stack>
  </Sec>
</BaseLayout>
