# Cloudflare Pages headers (https://developers.cloudflare.com/pages/configuration/headers/)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The in-app Docs reader iframes the public docs (https://provisa.dev/docs/).
# X-Frame-Options: DENY on /* would block that, and XFO can't allow-list
# origins, so detach it for /docs/* and use CSP frame-ancestors instead. The
# docs are public and the app is self-hosted (embedder origin varies), so any
# ancestor is permitted. Marketing pages keep DENY.
/docs/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *

# Astro fingerprints everything under /_astro/, so it can cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts keep stable names; cache for 30 days.
/fonts/*
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=604800

# Legacy image URLs from the previous site (kept so external links resolve).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# styles.css (used by the Functions' confirmation pages) and the HTML keep
# stable filenames, so they must revalidate (ETag 304) instead of caching.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
